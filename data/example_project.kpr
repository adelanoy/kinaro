  "tests": {
    "suites": [
      {
        "id": "w9ax9ndt",
        "name": "User API",
        "description": [
          "## User Api",
          "This suite covers user-related API such as:",
          "- **`POST /users`** Creating a user",
          "- **`GET /users`** Retrieving user information"
        ],
        "children": [
          {
            "type": "Case",
            "id": "m1c3t1h2",
            "name": "Create user",
            "description": [
              "## Create user",
              "This case tests the __POST__ _/user_ API"
            ],
            "steps": [
              {
                "id": "8fg5v9s7",
                "name": "Send POST request",
                "description": [
                  "## User Api",
                  "This suite covers user-related API such as:",
                  "- **`POST /users`** Creating a user",
                  "- **`GET /users`** Retrieving user information"
                ],
                "data": {
                  "Rest": {
                    "method": "POST",
                    "endpoint": "http://localhost:8080",
                    "params": [
                      {
                        "type": "header",
                        "name": "Accept",
                        "value": "application/json"
                      },
                      {
                        "type": "header",
                        "name": "Authorization",
                        "value": "Bearer {token}"
                      }
                    ],
                    "body": {
                      "type": "raw",
                      "contentType": "application/json",
                      "lines": [
                        "{",
                        "  \"name\": \"Jane Doe\",",
                        "  \"email\": \"jane.doe@example.com\"",
                        "}"
                      ]
                    }
                  }
                }
              },
              {
                "id": "gn52f6s1",
                "name": "Assert 201 Created",
                "data": {
                  "Delay": {
                    "duration": 10000,
                    "unit": "Millisecond"
                  }
                }
              },
              {
                "id": "s7d2b8t4",
                "name": "PUT Request",
                "data": {
                  "Rest": {
                    "method": "PUT",
                    "endpoint": "http://localhost:8080"
                  }
                }
              }
            ]
          },
          {
            "type": "Case",
            "id": "rmwf1e8b",
            "name": "Get user by id",
            "steps": [
              {
                "id": "5sm48hcz",
                "name": "Send GET request",
                "data": {
                  "Rest": {
                    "method": "GET",
                    "endpoint": "/users/{id}",
                    "params": [
                      {
                        "type": "path",
                        "name": "id",
                        "value": "42"
                      },
                      {
                        "type": "header",
                        "name": "Accept",
                        "value": "application/json"
                      },
                      {
                        "type": "header",
                        "name": "Authorization",
                        "value": "Bearer {token}"
                      }
                    ]
                  }
                }
              },
              {
                "id": "nz8sp5jj",
                "name": "Assert response body",
                "data": {
                  "Delay": {
                    "duration": 1000,
                    "unit": "Millisecond"
                  }
                }
              }
            ]
          },
          {
            "type": "Step",
            "id": "9wc4mqh4",
            "name": "Health check",
            "data": {
              "Rest": {
                "method": "HEAD",
                "endpoint": "/health"
              }
            }
          }
        ]
      },
      {
        "id": "cqns4e03",
        "name": "Authentication",
        "children": [
          {
            "type": "Case",
            "id": "tsrsq9q0",
            "name": "Login",
            "steps": [
              {
                "id": "2519qrj6",
                "name": "Send login request",
                "data": {
                  "Rest": {
                    "method": "POST",
                    "endpoint": "/auth/login",
                    "params": [
                      {
                        "type": "header",
                        "name": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "type": "formUrlEncoded",
                      "fields": [
                        {
                          "name": "username",
                          "value": "admin"
                        },
                        {
                          "name": "password",
                          "value": "dev-secret"
                        },
                        {
                          "name": "remember_me",
                          "value": "true",
                          "disabled": true
                        }
                      ]
                    }
                  }
                }
              },
              {
                "id": "hcf8adwh",
                "name": "Assert 200 OK",
                "data": {
                  "Delay": {
                    "duration": 1000,
                    "unit": "Millisecond"
                  }
                }
              },
              {
                "id": "8azcs6h5",
                "name": "Extract auth token",
                "data": {
                  "Delay": {
                    "duration": 1000,
                    "unit": "Millisecond"
                  }
                }
              }
            ]
          },
          {
            "type": "Step",
            "id": "tggqhymf",
            "name": "Token refresh",
            "data": {
              "Rest": {
                "method": "DELETE",
                "endpoint": "/auth/refresh",
                "params": [
                  {
                    "type": "header",
                    "name": "Accept",
                    "value": "application/json"
                  },
                  {
                    "type": "cookie",
                    "name": "refresh_token",
                    "value": "{refresh_token}"
                  }
                ]
              }
            }
          },
          {
            "type": "Case",
            "id": "wrf0qn2r",
            "name": "Logout",
            "steps": [
              {
                "id": "tkn95hgb",
                "name": "Send logout request",
                "data": {
                  "Rest": {
                    "method": "PUT",
                    "endpoint": "/auth/logout",
                    "params": [
                      {
                        "type": "header",
                        "name": "Authorization",
                        "value": "Bearer {token}"
                      },
                      {
                        "type": "cookie",
                        "name": "session",
                        "value": "{session}"
                      }
                    ]
                  }
                }
              },
              {
                "id": "5wbmxgm8",
                "name": "Assert session invalidated",
                "data": {
                  "Delay": {
                    "duration": 1000,
                    "unit": "Millisecond"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "id": "d27vkmb0",
        "name": "Product Catalog",
        "description": [
          "Covers listing, searching, and retrieving products."
        ],
        "children": [
          {
            "type": "Case",
            "id": "vde68gkg",
            "name": "List products",
            "steps": [
              {
                "id": "yv6c62jz",
                "name": "Send GET request",
                "data": {
                  "Rest": {
                    "method": "HEAD",
                    "endpoint": "/products",
                    "params": [
                      {
                        "type": "query",
                        "name": "page",
                        "value": "1"
                      },
                      {
                        "type": "query",
                        "name": "size",
                        "value": "20"
                      },
                      {
                        "type": "query",
                        "name": "sort",
                        "value": "price",
                        "disabled": true
                      },
                      {
                        "type": "header",
                        "name": "Accept",
                        "value": "application/json"
                      }
                    ]
                  }
                }
              },
              {
                "id": "kgmv92ns",
                "name": "Assert paginated response",
                "data": {
                  "Delay": {
                    "duration": 1000,
                    "unit": "Millisecond"
                  }
                }
              }
            ]
          },
          {
            "type": "Case",
            "id": "dh3xdxcg",
            "name": "Search products by name",
            "steps": [
              {
                "id": "250xbpvd",
                "name": "Send GET request with query param",
                "data": {
                  "Rest": {
                    "method": "GET",
                    "endpoint": "/products",
                    "params": [
                      {
                        "type": "query",
                        "name": "name",
                        "value": "lamp"
                      },
                      {
                        "type": "query",
                        "name": "tag",
                        "value": "indoor"
                      },
                      {
                        "type": "query",
                        "name": "tag",
                        "value": "led"
                      },
                      {
                        "type": "header",
                        "name": "Accept",
                        "value": "application/json"
                      }
                    ]
                  }
                }
              },
              {
                "id": "n7tvsv0c",
                "name": "Assert matching results",
                "data": {
                  "Delay": {
                    "duration": 1000,
                    "unit": "Millisecond"
                  }
                }
              }
            ]
          },
          {
            "type": "Step",
            "id": "2m3zekmb",
            "name": "Product count check",
            "data": {
              "Delay": {
                "duration": 1000,
                "unit": "Millisecond"
              }
            }
          },
          {
            "type": "Step",
            "id": "refzy5r1",
            "name": "Submit product review",
            "data": {
              "Rest": {
                "method": "POST",
                "endpoint": "/products/{id}/reviews",
                "params": [
                  {
                    "type": "path",
                    "name": "id",
                    "value": "42"
                  },
                  {
                    "type": "header",
                    "name": "Accept",
                    "value": "application/json"
                  },
                  {
                    "type": "header",
                    "name": "Authorization",
                    "value": "Bearer {token}"
                  }
                ],
                "body": {
                  "type": "formUrlEncoded",
                  "fields": [
                    {
                      "name": "rating",
                      "value": "4"
                    },
                    {
                      "name": "title",
                      "value": "Bright and compact"
                    },
                    {
                      "name": "comment",
                      "value": "Works great on my desk & uses little power."
                    },
                    {
                      "name": "anonymous",
                      "value": "true",
                      "disabled": true
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    ]
  }
}